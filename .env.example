# Copy to .env (git-ignored) before `docker compose up`.

# User the Airflow containers run as. Linux: set to the output of `id -u` so files in logs/ and
# .local-data/ belong to you. macOS and Windows: leave as is.
AIRFLOW_UID=50000

# Login for http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Only for docker-compose.gcs.yaml: the folder holding your gcloud Application Default Credentials.
#   Linux/macOS: /home/<you>/.config/gcloud     Windows: C:/Users/<you>/AppData/Roaming/gcloud
# GCLOUD_CONFIG_DIR=

# Email alerts (failed tasks, schema errors, data drift). Off while PRIMER_ALERT_EMAILS is empty.
# For Gmail, PRIMER_SMTP_PASSWORD is an app password (Google account → Security → App passwords),
# not your account password. Test with: primer-data test-alert
# PRIMER_ALERT_EMAILS=you@example.com,teammate@example.com
# PRIMER_SMTP_HOST=smtp.gmail.com
# PRIMER_SMTP_PORT=587
# PRIMER_SMTP_USER=
# PRIMER_SMTP_PASSWORD=
# PRIMER_ALERT_FROM=
