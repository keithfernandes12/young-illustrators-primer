{
  "enableAllProjectMcpServers": true,
  "env": {
    "PRIMER_DATA_URI": ".local-data",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(python scripts/check_docs.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(primer-data sources:*)",
      "Bash(primer-data versions:*)",
      "Bash(python .claude/skills/verify/scripts/verify.py:*)",
      "Bash(python .claude/skills/golden-gate/scripts/check_gate.py:*)",
      "Bash(python .claude/skills/privacy-guard/scripts/privacy_lint.py:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gcloud config list:*)",
      "Bash(gcloud run services describe:*)",
      "Bash(gcloud run services list:*)",
      "Bash(gcloud run revisions list:*)",
      "Bash(gcloud logging read:*)",
      "Bash(gcloud ai custom-jobs list:*)",
      "Bash(gcloud ai custom-jobs describe:*)",
      "Bash(gcloud ai custom-jobs stream-logs:*)",
      "Bash(terraform -chdir=infra fmt:*)",
      "Bash(terraform -chdir=infra validate:*)",
      "Bash(terraform -chdir=infra plan:*)"
    ],
    "ask": [
      "Bash(gh pr review:*)",
      "Bash(gh label:*)",
      "Bash(git tag:*)",
      "Bash(gh run rerun:*)",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__transitionJiraIssue",
      "mcp__atlassian__createIssueLink",
      "mcp__atlassian__addWorklogToJiraIssue",
      "mcp__atlassian__createConfluencePage",
      "mcp__atlassian__updateConfluencePage",
      "Bash(gcloud builds submit:*)",
      "Bash(gcloud run deploy:*)",
      "Bash(bash .claude/skills/deploy-cloud-run/scripts/deploy_canary.sh:*)",
      "Bash(terraform -chdir=infra apply:*)",
      "Bash(terraform -chdir=infra init:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -fr /:*)",
      "Bash(rm -r /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -fr ~:*)",
      "Bash(rm -r ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf ..:*)",
      "Bash(rm -rf ../:*)",
      "Bash(rmdir /s:*)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(rm -rf / *)",
      "PowerShell(rm -fr / *)",
      "PowerShell(rm -r / *)",
      "PowerShell(rm -rf ~ *)",
      "PowerShell(rm -fr ~ *)",
      "PowerShell(rm -r ~ *)",
      "PowerShell(rm -rf $HOME *)",
      "PowerShell(rm -rf .. *)",
      "PowerShell(rm -rf ../ *)",
      "PowerShell(rmdir /s *)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gcloud auth:*)",
      "Bash(dvc push:*)",
      "Bash(dvc gc:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform -chdir=infra destroy:*)",
      "Bash(gcloud iam service-accounts keys create:*)",
      "Bash(gcloud projects add-iam-policy-binding:*)",
      "Read(.env)",
      "Read(**/*service-account*.json)",
      "Read(**/*credentials*.json)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(gcloud auth *)",
      "PowerShell(dvc push *)",
      "PowerShell(dvc gc *)",
      "PowerShell(terraform destroy *)",
      "PowerShell(terraform -chdir=infra destroy *)",
      "PowerShell(gcloud iam service-accounts keys create *)",
      "PowerShell(gcloud projects add-iam-policy-binding *)",
      "Bash(gcloud run services update-traffic:*)",
      "PowerShell(gcloud run services update-traffic *)",
      "Bash(gcloud run jobs execute:*)",
      "PowerShell(gcloud run jobs execute *)",
      "Bash(gcloud ai custom-jobs create:*)",
      "PowerShell(gcloud ai custom-jobs create *)",
      "Bash(gcloud ai custom-jobs cancel:*)",
      "PowerShell(gcloud ai custom-jobs cancel *)",
      "Bash(bash .claude/skills/deploy-cloud-run/scripts/promote.sh:*)",
      "PowerShell(bash .claude/skills/deploy-cloud-run/scripts/promote.sh *)",
      "Bash(bash .claude/skills/deploy-cloud-run/scripts/rollback.sh:*)",
      "PowerShell(bash .claude/skills/deploy-cloud-run/scripts/rollback.sh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python3; $P -c \"\" 2>/dev/null || P=python; exec \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "P=python3; $P -c \"\" 2>/dev/null || P=python; exec \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\""
          },
          {
            "type": "command",
            "command": "P=python3; $P -c \"\" 2>/dev/null || P=python; exec \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_cloud.py\""
          }
        ]
      }
    ]
  }
}
