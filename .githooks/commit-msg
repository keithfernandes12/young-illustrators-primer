#!/bin/sh
# Git runs this before recording a commit. The check itself is commit_msg.py next to this file.
# Pick the interpreter first: on Windows `python3` is often the Microsoft Store stub, which fails;
# on macOS `python` often does not exist.
P=python3
"$P" -c "" 2>/dev/null || P=python
exec "$P" "$(dirname "$0")/commit_msg.py" "$@"
